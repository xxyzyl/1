# Runtime
NODE_ENV=development
APP_PORT=3000
APP_BASE_URL=http://localhost:3000
LOG_LEVEL=info

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/life_system

# Authentication (development placeholders only)
AUTH_SECRET=replace-with-a-long-random-secret
AUTH_ISSUER=http://localhost:3000

# AI provider abstraction
AI_PROVIDER=openai
AI_MODEL=replace-with-model-name
AI_API_KEY=replace-me

# Jobs and cache
REDIS_URL=redis://localhost:6379
JOB_SIGNING_SECRET=replace-me

# Optional connectors; keep empty until explicitly configured and authorized
CALENDAR_PROVIDER=
CALENDAR_CLIENT_ID=
CALENDAR_CLIENT_SECRET=
TASK_PROVIDER=
TASK_CLIENT_ID=
TASK_CLIENT_SECRET=

# Notifications
NOTIFICATION_PROVIDER=
NOTIFICATION_WEBHOOK_URL=

# Privacy and data retention
DATA_ENCRYPTION_KEY=replace-with-a-key-managed-outside-git
AUDIT_RETENTION_DAYS=365
DEFAULT_DATA_FRESHNESS_HOURS=24
