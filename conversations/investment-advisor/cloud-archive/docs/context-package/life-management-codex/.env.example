# 人生管理系统 4.0 本地开发环境变量模板
# 复制为 .env 后填写。不要把真实 .env 提交到仓库。

APP_NAME=life-management-system
APP_ENV=development
APP_DEBUG=true
APP_HOST=127.0.0.1
API_PORT=8000
WEB_PORT=3000
APP_TIMEZONE=Asia/Shanghai
SERVER_TIMEZONE=UTC

# 本地开发默认 mock-first。没有模型密钥也应能跑通核心测试和 demo。
MODEL_PROVIDER=mock
MODEL_DEFAULT=mock-life-planner-v1
OPENAI_API_KEY=
MODEL_REQUEST_TIMEOUT_SECONDS=60
MODEL_DAILY_BUDGET_CENTS=

# PostgreSQL 是推荐基线。首次开发可用 docker 或本地 PostgreSQL。
DATABASE_URL=postgresql://life_user:life_password@127.0.0.1:5432/life_management
DATABASE_POOL_SIZE=5
DATABASE_SSL_MODE=disable

# MVP 可先用数据库队列表；启用 Redis 前保持为空。
REDIS_URL=
JOB_QUEUE_BACKEND=database
JOB_WORKER_ENABLED=false

# 文件存储。生产可替换为对象存储。
FILE_STORAGE_BACKEND=local
FILE_STORAGE_LOCAL_DIR=./storage/files
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=

# 安全。请在真实部署中替换为强随机值。
SESSION_SECRET=change-me-local-only
JWT_SECRET=change-me-local-only
CORS_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
COOKIE_SECURE=false

# 主动服务默认关闭。
PROACTIVE_SERVICE_ENABLED=false
PROACTIVE_MAX_NOTIFICATIONS_PER_DAY=3
PROACTIVE_QUIET_HOURS_START=22:00
PROACTIVE_QUIET_HOURS_END=08:00
PROACTIVE_DEFAULT_CHANNEL=in_app

# 外部连接器默认关闭。只在用户明确授权和完成读写边界设计后开启。
CONNECTORS_ENABLED=false
GOOGLE_CALENDAR_ENABLED=false
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GMAIL_ENABLED=false
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
TODOIST_ENABLED=false
TODOIST_CLIENT_ID=
TODOIST_CLIENT_SECRET=
TICKTICK_ENABLED=false
TICKTICK_CLIENT_ID=
TICKTICK_CLIENT_SECRET=

# 审计与日志。
LOG_LEVEL=INFO
AUDIT_LOG_ENABLED=true
AUDIT_LOG_RETENTION_DAYS=365
PII_REDACTION_IN_LOGS=true

# 测试。
TEST_DATABASE_URL=postgresql://life_test:life_test_password@127.0.0.1:5432/life_management_test
E2E_BASE_URL=http://127.0.0.1:3000
