# Runtime
APP_ENV=development
APP_NAME=life-management-system
APP_HOST=127.0.0.1
APP_PORT=8787
APP_TIMEZONE=Asia/Shanghai

# Storage
DATABASE_URL=sqlite:///./data/life_management.db
DATA_DIR=./data
EXPORT_DIR=./exports
LOG_LEVEL=INFO

# AI provider - fill only in local untracked .env
LLM_PROVIDER=openai
LLM_MODEL=
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Security
SESSION_SECRET=replace-with-a-random-local-secret
ENCRYPTION_KEY=
ALLOW_EXTERNAL_ACTIONS=false

# Sync and scheduling
SYNC_ENABLED=false
SYNC_INTERVAL_MINUTES=60
NOTIFICATIONS_ENABLED=false
NOTIFICATION_DRY_RUN=true

# Optional data sources; keep disabled until explicit consent is recorded
GOOGLE_CALENDAR_ENABLED=false
TODO_PROVIDER=
GOOGLE_DRIVE_ENABLED=false
HEALTH_DATA_PROVIDER=
FINANCE_DATA_PROVIDER=

# Observability
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
