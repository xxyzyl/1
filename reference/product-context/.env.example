# Runtime
APP_ENV=development
APP_NAME=life-management-system
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000
LOG_LEVEL=info
TIMEZONE=Asia/Shanghai

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/life_management
REDIS_URL=redis://localhost:6379/0

# Model gateway - never commit real keys
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_EMBEDDING_MODEL=
MODEL_REQUEST_TIMEOUT_SECONDS=60
MODEL_MONTHLY_BUDGET=

# Storage
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=life-management
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=

# Security
SESSION_SECRET=
ENCRYPTION_KEY=
DATA_RETENTION_DAYS=
ALLOW_ANALYTICS=false

# Optional integrations, disabled unless explicitly authorized
CALENDAR_PROVIDER=none
CALENDAR_CLIENT_ID=
CALENDAR_CLIENT_SECRET=
TASK_PROVIDER=none
TASK_CLIENT_ID=
TASK_CLIENT_SECRET=
NOTIFICATION_PROVIDER=none
NOTIFICATION_WEBHOOK_URL=

# Background jobs
JOB_POLL_INTERVAL_SECONDS=60
QUIET_HOURS_START=22:00
QUIET_HOURS_END=08:00
MAX_REMINDERS_PER_DAY=3

